-              float scale;
-              float scale_value = i + j * SCALE_FACTORS_STEPS;
-
-              if (!is_scale_valid_for_size (width, height, scale_value))
-                continue;
-
-              scale = meta_get_closest_monitor_scale_factor_for_resolution (width,

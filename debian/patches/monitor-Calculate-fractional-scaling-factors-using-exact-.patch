+static unsigned int
+highest_common_factor (unsigned int x,
+                       unsigned int y)
 {
-  unsigned int i, j;
-  float scaled_h;
-  float scaled_w;
-  float best_scale;
-  int base_scaled_w;
-  gboolean found_one;
+  unsigned int a = x;
+  unsigned int b = y;
 
-  best_scale = 0;
+  while (a > 0 && b > 0)

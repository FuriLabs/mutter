+
+  if (!image_type)
+    {
+      static const GTypeInfo image_info =
+      {
+	sizeof (MetaSelectImageClass),
+	NULL,           /* base_init */
+	NULL,           /* base_finalize */
+	(GClassInitFunc) meta_select_image_class_init,
+	NULL,           /* class_finalize */

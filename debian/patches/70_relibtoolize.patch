+msgstr "Ändra storlek på fönster"
+
+#: ../src/metacity.schemas.in.h:59
+msgid "Run a defined command"
+msgstr "Kör ett angivet kommando"
+
+#: ../src/metacity.schemas.in.h:60
+msgid "Run a terminal"
+msgstr "Kör en terminal"

diff -urN -x config.guess -x config.sub mewmetacity-2.12.3.orig/src/update-from-egg.sh metacity-2.12.3/src/update-from-egg.sh
--- mewmetacity-2.12.3.orig/src/update-from-egg.sh	1970-01-01 01:00:00.000000000 +0100
+++ metacity-2.12.3/src/update-from-egg.sh	2002-07-15 16:18:51.000000000 +0200
@@ -0,0 +1,25 @@
+#!/bin/sh
+
+function die() {
+  echo $*
+  exit 1
+}
+
+if test -z "$EGGDIR"; then
+   echo "Must set EGGDIR"
+   exit 1
+fi
+
+if test -z "$EGGFILES"; then
+   echo "Must set EGGFILES"
+   exit 1
+fi
+
+for FILE in $EGGFILES; do
+  if cmp -s $EGGDIR/$FILE $FILE; then
+     echo "File $FILE is unchanged"
+  else
+     cp $EGGDIR/$FILE $FILE || die "Could not move $EGGDIR/$FILE to $FILE"
+     echo "Updated $FILE"
+  fi
+done

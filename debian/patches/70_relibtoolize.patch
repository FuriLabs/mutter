diff -urN -x config.guess -x config.sub mewmetacity-2.12.3.orig/src/testasyncgetprop.c metacity-2.12.3/src/testasyncgetprop.c
--- mewmetacity-2.12.3.orig/src/testasyncgetprop.c	1970-01-01 01:00:00.000000000 +0100
+++ metacity-2.12.3/src/testasyncgetprop.c	2003-09-30 22:05:35.000000000 +0200
@@ -0,0 +1,495 @@
+/*

+++ metacity-2.12.3/src/wm-tester/main.c	2002-10-26 23:56:50.000000000 +0200
@@ -0,0 +1,245 @@
+/* WM tester main() */
+
+/* 
+ * Copyright (C) 2001 Havoc Pennington
+ * 

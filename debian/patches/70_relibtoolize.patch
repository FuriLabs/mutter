+#, c-format
+msgid ""
+"Property %s on window 0x%lx contained invalid UTF-8 for item %d in the list\n"
+msgstr ""
+"Egenskap %s på vindu 0x%lx inneholdt ugyldig UTF-8 for oppføring %d i "
+"listen\n"

+#ifndef META_PLACE_H
+#define META_PLACE_H
+
+#include "window.h"
+#include "frame.h"
+
+typedef enum _MetaWindowEdgePosition MetaWindowEdgePosition;
+
+enum _MetaWindowEdgePosition
+{
+  META_WINDOW_EDGE_TOP = 0,

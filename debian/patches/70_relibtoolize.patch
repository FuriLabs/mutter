diff -urN -x config.guess -x config.sub mewmetacity-2.12.3.orig/src/bell.c metacity-2.12.3/src/bell.c
--- mewmetacity-2.12.3.orig/src/bell.c	1970-01-01 01:00:00.000000000 +0100
+++ metacity-2.12.3/src/bell.c	2005-10-03 21:22:40.000000000 +0200
@@ -0,0 +1,255 @@
+/* Metacity visual bell */
+
+/* 
+ * Copyright (C) 2002 Sun Microsystems Inc.
+ * 
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the

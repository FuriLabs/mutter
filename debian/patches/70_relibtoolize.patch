+
+#: ../src/theme-parser.c:837 ../src/theme-parser.c:905
+#: ../src/theme-parser.c:943 ../src/theme-parser.c:1020
+#, c-format
+msgid "<%s> name \"%s\" used a second time"
+msgstr "<%s> 이름 \"%s\"이(가) 두번 사용되었습니다"
+
+#: ../src/theme-parser.c:849 ../src/theme-parser.c:955

+msgstr "창을 11번째 작업 공간으로 옮기기"
+
+#: ../src/metacity.schemas.in.h:44
+msgid "Move window to workspace 12"
+msgstr "창을 12번째 작업 공간으로 옮기기"
+
+#: ../src/metacity.schemas.in.h:45

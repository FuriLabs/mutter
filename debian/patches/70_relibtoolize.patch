+
+  /* position of client, size of frame */
+  int child_x;
+  int child_y;
+  int right_width;
+  int bottom_height;
+
+  guint mapped : 1;
+  guint need_reapply_frame_shape : 1;
+  guint is_flashing : 1; /* used by the visual bell flash */
+};

+#ifdef HAVE_GCONF
+/* from eel */
+static gboolean
+str_has_prefix (const char *haystack, const char *needle)
+{
+  const char *h, *n;
+  
+  /* Eat one character at a time. */
+  h = haystack == NULL ? "" : haystack;
+  n = needle == NULL ? "" : needle;
+  do
+    {
+      if (*n == '\0') 
+        return TRUE;
+      if (*h == '\0')
+        return FALSE;
+    }
+  while (*h++ == *n++);
+
+  return FALSE;
+}

+msgstr "Siirrä ikkunaa yksi työtila oikealle"
+
+#: ../src/metacity.schemas.in.h:40
+msgid "Move window one workspace up"
+msgstr "Siirrä ikkunaa yksi työtila ylös"
+
+#: ../src/metacity.schemas.in.h:41
